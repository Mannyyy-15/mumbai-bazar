<!--
  Status-bar notification icon.

  Android masks this to a silhouette: every non-transparent pixel is redrawn in
  a single colour (the default_notification_color set in the manifest), and
  everything else is dropped. So it MUST be a white-on-transparent shape — a
  full-colour logo comes out as a solid grey square, which is what happens when
  an app points this at @mipmap/ic_launcher.

  A shopping bag rather than the "MB" monogram: at 24dp the letterforms fill in
  and become an unreadable blob, while a bag stays legible and reads as retail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Bag body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,8h14c0.55,0 1,0.45 1,1l-0.9,10.1c-0.05,0.51 -0.48,0.9 -1,0.9H5.9c-0.52,0 -0.95,-0.39 -1,-0.9L4,9c0,-0.55 0.45,-1 1,-1z" />

    <!-- Handle: an open arc, so the shape still reads as a bag once flattened -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M8.5,8V6.5C8.5,4.57 10.07,3 12,3s3.5,1.57 3.5,3.5V8" />
</vector>
