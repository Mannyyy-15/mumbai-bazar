SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_STORE_DOMAIN=1ttsg4-3a.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=replace-with-storefront-token
PUBLIC_STOREFRONT_API_VERSION=2026-07
PUBLIC_STOREFRONT_ID=replace-with-storefront-id
PRIVATE_STOREFRONT_API_TOKEN=replace-with-private-token
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=replace-with-client-id
PUBLIC_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/account
SHOP_ID=replace-with-shop-id
PUBLIC_META_PIXEL_ID=0000000000000000

# Shopify requires checkout on its own subdomain for Hydrogen storefronts, so
# this is NOT optional. One domain cannot point at both Oxygen (storefront) and
# Online Store (checkout) infrastructure.
# Must also be registered in the Razorpay dashboard, or payments fail with
# "Business - Website Mismatch" the moment a customer tries to pay.
PUBLIC_CHECKOUT_DOMAIN=checkout.mumbaibazar.com
